  "diwali_audit_summary": {
    "framework": "Station-Matched Paired Event Study with Pre-Trend Decomposition",
    "late_october_years_mean_surge": 82.28,
    "mid_november_years_mean_surge": -33.53,
    "causal_finding": "Diwali emissions induce acute, statistically significant station-matched surges (+32.7 to +120.3 pts) when the festival occurs in late October against a moderate baseline. Conversely, in mid-November, the festival coincides with peak regional stubble smoke and boundary layer collapse, where pre-event air is already severe (>350-400), dampening the visible incremental surge."
  }
